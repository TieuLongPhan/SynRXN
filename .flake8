[flake8]
max-complexity = 16
max-line-length = 120
extend-ignore = E203
exclude = .git,__pycache__,.venv,venv,archive,.cache,Data,build,dist,doc/_build
# Existing orchestration exceptions cover complexity only.
per-file-ignores =
    synrxn/data/build_manifest.py:C901
    synrxn/__main__.py:C901
    synrxn/data/data_loader.py:C901
    synrxn/statistics/auto_test.py:C901
    synrxn/data/validate.py:C901
